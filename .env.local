# Variables d'environnement — § 4.7 du dossier de projet.
# Copier en .env.local pour le développement.

SITE_NAME=VELMA
SITE_URL=http://localhost:3000

WHATSAPP_NUMERO=237679910922
WHATSAPP_MESSAGE_MODELE=Bonjour, je veux la {produit} (réf. {reference}).

BOUTIQUE_ADRESSE=Akwa centre, Douala
# ⚠️ À obtenir du client — « Akwa centre » est un quartier, pas un point où
#    l'on se rend. Bloquant pour la mise en ligne (§ 4.7).
BOUTIQUE_REPERE=
BOUTIQUE_HORAIRES=Tous les jours, 7h – 22h

# SQLite exige un disque persistant en écriture (§ 4.2).
DATABASE_PATH=./data.sqlite

# ⚠️ Fournis par le client / générés par nous — lot back-office.
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE_HASH=
SESSION_SECRET=
